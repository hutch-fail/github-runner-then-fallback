# Local / consumer reference for github-runner-then-fallback.
# Copy to .env and replace filler values. Do not commit real secrets.

# Billing-capable token (classic PAT with admin:org, or fine-grained
# Organization administration: read). GITHUB_TOKEN is not enough.
ORG_BILLING_TOKEN=ghp_replace_with_billing_capable_token

# Included/free Linux Actions minutes for the billing period (Free org ≈ 2000).
ACTIONS_INCLUDED_MINUTES=2000

# Organization whose Actions (and Blacksmith) usage is checked.
ORGANIZATION=hutch-fail

# Runner labels (comma-separated if multiple).
PRIMARY_RUNNER=ubuntu-latest
FALLBACK_RUNNER=blacksmith-2vcpu-ubuntu-2404

# If true, emit last-resort runner when a required check fails
# (two-way → FALLBACK_RUNNER; chain → FINAL_RUNNER).
FALLBACK_ON_ERROR=true

# --- Optional chain mode (leave headroom, then usejoy for paid minutes) ---
# When FINAL_RUNNER is set, determine-runner should runs-on that same label
# so the meter job does not spend GitHub or Blacksmith minutes.
FINAL_RUNNER=usejoy-2vcpu-ubuntu-2404
USAGE_THRESHOLD=80
# Pricing page default: 3000 x64 2vCPU minutes/org/month (not returned by CLI).
BLACKSMITH_INCLUDED_MINUTES=3000
# From: blacksmith org-token create
BLACKSMITH_API_TOKEN=bs_replace_with_org_token
