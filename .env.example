# Local / consumer reference for github-runner-then-fallback.
# Copy to .env and replace filler values. Do not commit real secrets.
#
# Action defaults (no org vars required for labels/budgets/threshold):
#   primary=ubuntu-latest, fallback=blacksmith-2vcpu-ubuntu-2404,
#   final=usejoy-2vcpu-ubuntu-2404, included=2000, blacksmith=3000, threshold=80
# Detect job: run on the final (usejoy) label — see determine-runner.yml.

# Required secret — classic PAT with admin:org (billing usage). Not GITHUB_TOKEN.
ORG_BILLING_TOKEN=ghp_replace_with_billing_capable_token

# Chain mode (default): Blacksmith org token from `blacksmith org-token create`.
# If unset, Blacksmith pool is skipped and overage goes to usejoy after GHA headroom.
BLACKSMITH_API_TOKEN=bs_replace_with_org_token

# Optional overrides (action already defaults these):
# ACTIONS_INCLUDED_MINUTES=2000
# BLACKSMITH_INCLUDED_MINUTES=3000
# USAGE_THRESHOLD=80
# PRIMARY_RUNNER=ubuntu-latest
# FALLBACK_RUNNER=blacksmith-2vcpu-ubuntu-2404
# FINAL_RUNNER=usejoy-2vcpu-ubuntu-2404
# ORGANIZATION=hutch-fail
